DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/finsight
POSTGRES_PORT=5432
DATABASE_USERNAME=finsight
DATABASE_PASSWORD=replace-with-a-unique-local-secret
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=/api
# PayPal Sandbox only. Server-side variables; never use VITE_ prefixes.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_SIGNED_AMOUNT_DIRECTION_VERIFIED=false
# AES-256-GCM Master Encryption Key (Used for encrypting OAuth tokens and credentials at rest)
APP_ENCRYPTION_KEY=finsight-master-encryption-key-for-credentials-32b
# AI provider integration (When unset, privacy-safe deterministic rule engine is used)
AI_PROVIDER_API_KEY=
